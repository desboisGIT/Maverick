{
  "name": "maverick-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Maverick Mission Console: live view of what the drone sees, maps and plans",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "mock": "tsx mock/server.ts",
    "smoke": "tsx mock/smoke.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 5173"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/three": "0.170.0",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "ws": "8.18.0"
  }
}
