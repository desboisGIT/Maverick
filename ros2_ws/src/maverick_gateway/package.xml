<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>maverick_gateway</name>
  <version>0.1.0</version>
  <description>Websocket gateway between the host stack and the Mission Console.</description>
  <maintainer email="maintainer@example.com">Maverick</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>maverick_mapping</depend>
  <exec_depend>maverick_memory</exec_depend>
  <exec_depend>maverick_skills</exec_depend>
  <exec_depend>maverick_vo</exec_depend>
  <exec_depend>maverick_flight</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
