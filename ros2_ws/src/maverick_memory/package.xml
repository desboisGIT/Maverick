<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>maverick_memory</name>
  <version>0.1.0</version>
  <description>Scene graph: detection lifting, object store, room segmentation and typing.</description>
  <maintainer email="maintainer@example.com">Maverick</maintainer>
  <license>Apache-2.0</license>

  <depend>python3-numpy</depend>
  <depend>maverick_mapping</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
